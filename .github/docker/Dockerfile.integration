# Local Linux acceptance runner. It receives a committed bundle, never the
# operator's home, credentials, working tree, or Docker socket.
ARG BUN_VERSION=1.4.2
FROM oven/bun:${BUN_VERSION} AS bun
FROM node:22.20.0-trixie
COPY --from=bun /usr/local/bin/bun /opt/gstack-bun/bin/bun
ENV PATH=/opt/gstack-bun/bin:${PATH}
RUN ln -s /opt/gstack-bun/bin/bun /opt/gstack-bun/bin/bunx \
    && apt-get update \
    && apt-get install -y --no-install-recommends git python3 python3-venv curl unzip zip \
       jq bc file gcc libc6-dev poppler-utils fonts-noto-color-emoji xvfb xauth x11-utils zsh \
       gh ripgrep procps psmisc openssh-client \
    && git --no-lazy-fetch --version \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /workspace && chmod 1777 /workspace
ARG PLAYWRIGHT_VERSION
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/gstack-playwright
RUN npm exec --yes --package="playwright@${PLAYWRIGHT_VERSION}" -- playwright install --with-deps chromium \
    && chmod -R a+rwX /opt/gstack-playwright
ARG VALIDATION_UID=1000
ARG VALIDATION_GID=1000
RUN if ! getent group "${VALIDATION_GID}" >/dev/null; then groupadd --gid "${VALIDATION_GID}" gstack-validation; fi \
    && if ! getent passwd "${VALIDATION_UID}" >/dev/null; then \
         useradd --no-log-init --uid "${VALIDATION_UID}" --gid "${VALIDATION_GID}" \
           --home-dir /home/gstack-validation --no-create-home gstack-validation; \
       fi \
    && mkdir -p /home/gstack-validation \
    && chown "${VALIDATION_UID}:${VALIDATION_GID}" /home/gstack-validation
ENV HOME=/home/gstack-validation
WORKDIR /workspace
